.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(68, 138, 255);
}

/* 轨道样式 */
.timeline-track {
    background-color: rgba(51, 153, 229, 0.30);
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 100, 100, 0.3);
    margin-bottom: 1px;
}

.timeline-track.hovered {
    border-bottom-color: rgba(120, 120, 120, 0.4);
}

/* Clip样式 */
.timeline-clip {
    background-color: rgb(65, 105, 225);
    border-width: 1px;
    border-color: rgba(100, 149, 237, 0.8);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 4px;
    padding-right: 4px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
}

.timeline-clip.hovered {
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.4);
}

.timeline-clip.dragging {
    box-shadow: 0px 3px 8px rgba(65, 105, 225, 0.5);
}

/* 右侧拖拽缩放（水平双向箭头） */
.timeline-clip.cursor-resize-h {
    cursor: resize-horizontal;
}

/* Clip 按类型配色 */
.timeline-clip.type-animation { background-color: rgba(51, 153, 229, 0.50); border-color: rgba(36, 107, 160, 1.0); }
.timeline-clip.type-effect    { background-color: rgba(39, 223, 63, 0.5); border-color: rgba(160, 71, 36, 1.0); }
.timeline-clip.type-sound     { background-color: rgba(102, 204, 195, 0.5); border-color: rgba(71, 143, 71, 1.0); }
.timeline-clip.type-hitbox    { background-color: rgba(149, 70, 214, 0.5);  border-color: rgba(160, 36, 36, 1.0); }
.timeline-clip.type-active    { background-color: rgba(255, 193, 7, 0.55);   border-color: rgba(160, 120, 36, 1.0); }

/* 按钮按类型配色 */
.action-button {
    background-color: rgb(70, 70, 80);
    border-width: 1px;
    border-color: rgba(100, 100, 110, 0.8);
    border-radius: 4px;
    color: rgb(220, 220, 230);
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 2px;
    margin-right: 2px;
    margin-bottom: 4px;
    min-width: 80px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color;
}

.action-button:hover {
    background-color: rgb(90, 90, 100);
    border-color: rgba(130, 130, 140, 1.0);
    color: rgb(255, 255, 255);
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.2);
}

.action-button:active {
    background-color: rgb(50, 50, 60);
    border-color: rgba(80, 80, 90, 0.9);
}

/* 特效按钮 - 绿色系 */
.action-button.type-effect {
    background-color: rgba(39, 223, 63, 0.6);
    border-color: rgba(160, 71, 36, 0.8);
}

.action-button.type-effect:hover {
    background-color: rgba(49, 233, 73, 0.7);
    border-color: rgba(180, 81, 46, 1.0);
    box-shadow: 0px 2px 6px rgba(39, 223, 63, 0.3);
}

/* 音效按钮 - 青色系 */
.action-button.type-sound {
    background-color: rgba(102, 204, 195, 0.6);
    border-color: rgba(71, 143, 71, 0.8);
}

.action-button.type-sound:hover {
    background-color: rgba(112, 214, 205, 0.7);
    border-color: rgba(81, 153, 81, 1.0);
    box-shadow: 0px 2px 6px rgba(102, 204, 195, 0.3);
}

/* 碰撞盒按钮 - 紫色系 */
.action-button.type-hitbox {
    background-color: rgba(149, 70, 214, 0.6);
    border-color: rgba(160, 36, 36, 0.8);
}

.action-button.type-hitbox:hover {
    background-color: rgba(159, 80, 224, 0.7);
    border-color: rgba(180, 46, 46, 1.0);
    box-shadow: 0px 2px 6px rgba(149, 70, 214, 0.3);
}

/* 添加动画片段按钮 - 蓝色系 */
.action-button.type-animation {
    background-color: rgba(51, 153, 229, 0.6);
    border-color: rgba(36, 107, 160, 0.8);
}

.action-button.type-animation:hover {
    background-color: rgba(61, 163, 239, 0.7);
    border-color: rgba(46, 117, 170, 1.0);
    box-shadow: 0px 2px 6px rgba(51, 153, 229, 0.3);
}

/* Active按钮 - 黄色系 */
.action-button.type-active {
    background-color: rgba(255, 193, 7, 0.65);
    border-color: rgba(160, 120, 36, 0.8);
}

.action-button.type-active:hover {
    background-color: rgba(255, 203, 27, 0.75);
    border-color: rgba(180, 140, 56, 1.0);
    box-shadow: 0px 2px 6px rgba(255, 193, 7, 0.25);
}

/* 轨道添加按钮特殊样式 - 更加突出 */
.track-add-button {
    background-color: rgba(51, 153, 229, 0.8);
    border-width: 2px;
    border-color: rgba(36, 107, 160, 1.0);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    min-width: 120px;
}

.track-add-button:hover {
    background-color: rgba(61, 163, 239, 0.9);
    border-color: rgba(46, 117, 170, 1.0);
}

.track-add-button:active {
    background-color: rgba(41, 143, 219, 0.8);
    border-color: rgba(26, 97, 150, 1.0);
}

/* 选中高亮样式 */
.timeline-track.is-selected {
    border-top-width: 1.2px;
    border-right-width: 1.2px;
    border-bottom-width: 1.2px;
    border-left-width: 1.2px;
    border-top-color: rgba(255, 215, 0, 1);
    border-right-color: rgba(255, 215, 0, 1);
    border-bottom-color: rgba(255, 215, 0, 1);
    border-left-color: rgba(255, 215, 0, 1);
}

.timeline-clip.is-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 215, 0, 1);
    border-right-color: rgba(255, 215, 0, 1);
    border-bottom-color: rgba(255, 215, 0, 1);
    border-left-color: rgba(255, 215, 0, 1);
    box-shadow: 0px 3px 10px rgba(255, 215, 0, 0.25);
}

.timeline-clip.is-selected.dragging {
    box-shadow: 0px 3px 12px rgba(255, 120, 0, 0.3);
}

/* 重叠高亮样式 */
.overlap-highlight {
    border-top-width: 2px;
    border-bottom-width: 2px;
}

/* 播放进度条样式 */
.timeline-playhead {
    z-index: 1000;
    pointer-events: auto;
}

/* 播放进度条线样式 */
.timeline-playhead-line {
    z-index: 999;
    pointer-events: none;
    box-shadow: 0px 0px 2px rgba(255, 77, 77, 0.6);
}

/* 播放控制按钮基础样式 */
.playback-button {
    background-color: rgb(45, 45, 50);
    border-width: 1px;
    border-color: rgba(100, 100, 100, 0.5);
    border-radius: 4px;
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 2px;
    margin-right: 2px;
    min-width: 50px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color;
}

.playback-button:hover {
    background-color: rgb(55, 55, 60);
    border-color: rgba(130, 130, 130, 0.7);
    color: rgb(255, 255, 255);
}

.playback-button:active {
    background-color: rgb(35, 35, 40);
    border-color: rgba(80, 80, 80, 0.6);
}

/* Play按钮特殊样式 */
.play-button {
    background-color: rgb(50, 150, 50);
    border-color: rgba(70, 200, 70, 0.8);
    color: rgb(255, 255, 255);
}

.play-button:hover {
    background-color: rgb(60, 170, 60);
    border-color: rgba(90, 220, 90, 1.0);
    box-shadow: 0px 2px 4px rgba(50, 150, 50, 0.3);
}

.play-button:active {
    background-color: rgb(40, 130, 40);
    border-color: rgba(60, 180, 60, 0.9);
}

/* Stop按钮特殊样式 */
.stop-button {
    background-color: rgb(180, 50, 50);
    border-color: rgba(220, 70, 70, 0.8);
    color: rgb(255, 255, 255);
}

.stop-button:hover {
    background-color: rgb(200, 60, 60);
    border-color: rgba(240, 80, 80, 1.0);
    box-shadow: 0px 2px 4px rgba(180, 50, 50, 0.3);
}

.stop-button:active {
    background-color: rgb(160, 40, 40);
    border-color: rgba(200, 60, 60, 0.9);
}

/* Loop按钮特殊样式 */
.loop-button {
    background-color: rgb(50, 100, 180);
    border-color: rgba(70, 130, 220, 0.8);
    color: rgb(255, 255, 255);
}

.loop-button.is-looping {
    background-color: rgb(60, 170, 60);
    border-color: rgba(90, 220, 90, 1.0);
    color: rgb(255, 255, 255);
    box-shadow: 0px 2px 6px rgba(50, 150, 50, 0.25);
}

.loop-button:hover {
    background-color: rgb(60, 120, 200);
    border-color: rgba(90, 150, 240, 1.0);
    box-shadow: 0px 2px 4px rgba(50, 100, 180, 0.3);
}

.loop-button.is-looping:hover {
    background-color: rgb(70, 190, 70);
    border-color: rgba(110, 240, 110, 1.0);
}

.loop-button:active {
    background-color: rgb(40, 80, 160);
    border-color: rgba(60, 110, 200, 0.9);
}

.loop-button.is-looping:active {
    background-color: rgb(50, 150, 50);
    border-color: rgba(80, 210, 80, 0.9);
}

/* 播放时间显示样式 */
.time-display {
    background-color: rgb(30, 30, 35);
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.5);
    border-radius: 4px;
    color: rgb(200, 200, 200);
    font-size: 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 2px;
    margin-right: 2px;
    min-width: 100px;
    white-space: nowrap;
}

/* 时间轴ScrollView样式 */
#TimelineScrollView {
    background-color: rgb(18, 18, 20);
}

#TimelineScrollView #unity-content-container {
    flex-direction: column;
}

/* ScrollView水平滚动条样式 */
#TimelineScrollView .unity-scroller--horizontal {
    height: 14px;
}

#TimelineScrollView .unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: rgb(35, 35, 40);
    border-radius: 3px;
}

#TimelineScrollView .unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgb(70, 70, 80);
    border-radius: 3px;
}

#TimelineScrollView .unity-scroller--horizontal .unity-base-slider__dragger:hover {
    background-color: rgb(90, 90, 100);
}

#TimelineScrollView .unity-scroller--horizontal .unity-repeat-button {
    background-color: rgb(45, 45, 50);
    border-radius: 2px;
}

#TimelineScrollView .unity-scroller--horizontal .unity-repeat-button:hover {
    background-color: rgb(60, 60, 65);
}

/* 时间轴内容容器 */
#TimelineContent {
    background-color: rgb(20, 20, 22);
}

/* 轨道容器 */
#TrackContainer {
    background-color: rgb(18, 18, 20);
}
