<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Scripts/Editor/Skill/SkillEditorWindow.uss?fileID=7433441132597879392&amp;guid=9e62f868e573ba34aa7272c3063ae733&amp;type=3#SkillEditorWindow"/>
    <ui:VisualElement name="Top" style="height: 30px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; flex-direction: row; align-items: center; flex-shrink: 0;">
        <uie:ObjectField name="SelectConfig" style="flex-grow: 1; height: auto; width: auto; align-self: auto;"/>
        <uie:ObjectField name="SelectObj" style="flex-grow: 1;"/>
        <ui:Button text="&#21047;&#26032;" name="Refresh" style="flex-grow: 1;"/>
        <ui:Button text="&#35270;&#22270;&#65306;&#20840;&#23616;" name="ToggleViewMode" style="flex-grow: 0; width: 90px;"/>
        <ui:Label text="Speed:" name="Speed" style="flex-grow: 1; width: 7px;"/>
        <ui:Slider value="42" high-value="100" style="flex-grow: 1; width: 100px;"/>
        <ui:TextField value="1.0x" name="SpeedNum" style="flex-grow: 1; width: 5px; -unity-text-align: middle-center;"/>
        <ui:Button text="Play" name="Play" class="playback-button play-button" style="flex-grow: 1;"/>
        <ui:Button text="Stop" name="Stop" class="playback-button stop-button" style="flex-grow: 1;"/>
        <ui:Button text="Loop" name="Loop" class="playback-button loop-button" style="flex-grow: 1;"/>
        <ui:Label text="00.5s / 1.00s" name="TimeLength" class="time-display" style="flex-grow: 1; -unity-text-align: middle-center; width: 100px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Bottom" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="Left" style="flex-direction: column; flex-grow: 1; flex-shrink: 1; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; border-top-width: 1px; border-top-color: rgb(0, 0, 0); border-right-width: 1px; border-right-color: rgb(0, 0, 0); overflow: hidden;">
            <ui:ScrollView name="TimelineScrollView" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto" style="flex-grow: 1;">
                <ui:VisualElement name="TimelineContent" style="flex-direction: column;">
                    <ui:VisualElement name="Ruler" style="height: 30px; flex-shrink: 0;"/>
                    <ui:VisualElement name="TrackContainer" style="flex-grow: 0; flex-shrink: 0;"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="flex-grow: 0; flex-shrink: 0; width: 300px; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; border-top-width: 1px; border-top-color: rgb(0, 0, 0); flex-direction: column;">
            <ui:VisualElement name="TrackInfoPanel" style="flex-shrink: 0; padding: 8px; border-bottom-width: 1px; border-bottom-color: rgb(100, 100, 100); flex-direction: column;">
                <ui:Label text="&#36712;&#36947;&#20449;&#24687;" style="font-size: 14px; font-weight: bold; margin-bottom: 8px;"/>
                <ui:VisualElement style="flex-direction: column; gap: 4px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#36712;&#36947;&#31867;&#22411;:" style="width: 100px;"/>
                        <ui:Label name="TrackTypeLabel" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#29255;&#27573;&#25968;:" style="width: 100px;"/>
                        <ui:Label name="ClipCountLabel" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#24635;&#26102;&#38271;:" style="width: 100px;"/>
                        <ui:Label name="TotalDurationLabel" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="&#28155;&#21152;Clip" name="AddClipToTrackButton" style="margin-top: 8px; display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ClipPropertiesPanel" style="flex-grow: 1; padding: 8px; flex-direction: column; overflow-y: auto;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#29255;&#27573;&#23646;&#24615;" name="ClipPropertiesTitle" style="font-size: 14px; font-weight: bold;"/>
                        <ui:Label name="ClipIndexLabel" style="font-size: 14px; font-weight: bold; color: rgb(255, 80, 80); margin-left: 8px;"/>
                    </ui:VisualElement>
                    <ui:Button text="&#21024;&#38500;" name="DeleteClipButton" style="display: none; background-color: rgb(180, 60, 60);"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; gap: 8px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#21517;&#31216;:" style="width: 120px;"/>
                        <ui:TextField name="ClipNameField" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#24320;&#22987;&#26102;&#38388;(&#31186;):" style="width: 120px;"/>
                        <ui:FloatField value="0" name="StartTimeField" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#26102;&#38271;(&#31186;):" style="width: 120px;"/>
                        <ui:FloatField value="0" name="ClipLengthField" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#24635;&#24103;&#25968;:" style="width: 120px;"/>
                        <ui:IntegerField value="0" name="FrameField" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="AnimationFields" style="flex-direction: column; gap: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#21160;&#30011;&#29255;&#27573;:" style="width: 120px;"/>
                            <uie:ObjectField object-type="UnityEngine.AnimationClip" name="AnimationClipField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#25773;&#25918;&#36895;&#24230;:" style="width: 120px;"/>
                            <ui:FloatField value="1" name="SpeedField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#25773;&#25918;&#26102;&#38271;(&#31186;):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="DurationField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#28129;&#20837;&#26102;&#38388;:" style="width: 120px;"/>
                            <ui:FloatField value="0.25" name="FadeDurationField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#36755;&#20837;&#32531;&#20914;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0.5" name="InputBufferStartField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#21487;&#21462;&#28040;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0.4" name="CancelableTimeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#21160;&#30011;&#32467;&#26463;&#26102;&#38388;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0.9" name="AnimationEndField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="AnimationActionButtons" style="flex-direction: row; gap: 4px; margin-top: 8px;">
                            <ui:Button text="&#28155;&#21152;&#29305;&#25928;" name="AddEffectButton" style="flex-grow: 1;"/>
                            <ui:Button text="&#28155;&#21152;&#38899;&#25928;" name="AddSoundButton" style="flex-grow: 1;"/>
                            <ui:Button text="&#28155;&#21152;&#30896;&#25758;&#30418;" name="AddHitboxButton" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="EffectFields" style="flex-direction: column; gap: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#29305;&#25928;&#39044;&#21046;&#20307;:" style="width: 120px;"/>
                            <uie:ObjectField object-type="UnityEngine.GameObject" name="EffectPrefabField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#35302;&#21457;&#26102;&#38388;(&#31186;):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="EffectTriggerTimeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#24402;&#19968;&#21270;&#26102;&#38388;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="EffectNormalizedStartField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#36319;&#38543;&#30446;&#26631;:" style="width: 120px;"/>
                            <ui:Toggle name="FollowTargetField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="SoundFields" style="flex-direction: column; gap: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#38899;&#39057;&#29255;&#27573;:" style="width: 120px;"/>
                            <uie:ObjectField object-type="UnityEngine.AudioClip" name="AudioClipField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#35302;&#21457;&#26102;&#38388;(&#31186;):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="SoundTriggerTimeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#24402;&#19968;&#21270;&#26102;&#38388;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="SoundNormalizedStartField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#38899;&#37327;:" style="width: 120px;"/>
                            <ui:FloatField value="1" name="VolumeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="HitBoxFields" style="flex-direction: column; gap: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#24418;&#29366;&#31867;&#22411;:" style="width: 120px;"/>
                            <ui:EnumField name="ShapeTypeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Offset:" style="width: 120px;"/>
                            <ui:Vector3Field name="HitBoxOffsetField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Rotation:" style="width: 120px;"/>
                            <ui:Vector3Field name="HitBoxRotationField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Size:" style="width: 120px;"/>
                            <ui:Vector3Field name="HitBoxSizeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#24402;&#19968;&#21270;&#24320;&#22987;&#26102;&#38388;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="HitBoxNormalizedStartField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#24402;&#19968;&#21270;&#32467;&#26463;&#26102;&#38388;(0-1):" style="width: 120px;"/>
                            <ui:FloatField value="1" name="HitBoxNormalizedEndField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="&#35302;&#21457;&#26102;&#38388;(&#31186;):" style="width: 120px;"/>
                            <ui:FloatField value="0" name="HitBoxTriggerTimeField" style="flex-grow: 1;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ListView name="InfoListView" style="display: none; flex-grow: 0; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
